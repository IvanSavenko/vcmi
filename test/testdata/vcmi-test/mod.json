{
	"name" : "VCMI test fixtures",
	"description" : "Test-only maps, data and library entities. Loaded only by vcmitest, never shipped or scanned by the game.",
	"version" : "1.0",
	"author" : "VCMI Team",
	"contact" : "",
	"modType" : "Test",
	"keepDisabled" : true,
	"heroes" : [ "config/heroes.json" ],
	"creatures" : [ "config/creatures.json" ],
	"scripts" : [ "config/hotaScripts.json" ],
	"skills" : [ "config/hotaSkills.json", "config/skills.json" ],
	"spells" : [ "config/hotaSpells.json", "config/spells.json" ],
	"bonuses" : [ "config/hotaBonuses.json" ],
	"objects" : {
		"questGate" : {
			"name" : "Quest Gate",
			"handler" : "questGate",
			"types" : {
				"object" : { "visitableFromTop" : true }
			}
		},
		// visitable from top-right only according to template made for older versions
		"legacyVisitableFromTop" : {
			"handler" : "generic",
			"types" : {
				"object" : {
					"templates" : {
						"normal" : { "animation" : "AVXbuoy0", "visitableFrom" : [ "--+", "+-+", "+++" ], "mask" : [ "VA" ] }
					}
				}
			}
		},
		"explicitlyNotVisitableFromTop" : {
			"handler" : "generic",
			"types" : {
				"object" : {
					"visitableFromTop" : false,
					"templates" : {
						"normal" : { "animation" : "AVXbuoy0", "visitableFrom" : [ "+++", "+-+", "+++" ], "mask" : [ "VA" ] }
					}
				}
			}
		}
	},
	"settings" :
	{
		// HOTA fixtures (TinyH3MBuilder) need the HOTA map format supported; with only
		// core+vcmi active it is off by default. Identity identifier mapping is correct
		// for the SOD-range identifiers the fixtures use, except the Quest Gate: H3M
		// encodes it as BORDER_GATE:1000, which must map to our questGate object.
		"mapFormat" :
		{
			"hornOfTheAbyss" :
			{
				"supported" : true,
				"maxVersion" : 10,
				"objects" :
				{
					"questGate" : { "object" : [ 212, 1000 ] }
				}
			}
		}
	}
}
